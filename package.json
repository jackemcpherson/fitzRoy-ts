{
  "name": "fitzroy",
  "version": "6.0.0",
  "description": "TypeScript port of the fitzRoy R package — programmatic access to AFL data including match results, player stats, fixtures, ladders, and more",
  "keywords": [
    "afl",
    "aflw",
    "australian-football",
    "fitzroy",
    "sports-data"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jackemcpherson/fitzRoy-ts.git"
  },
  "bin": {
    "fitzroy": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas.d.ts",
      "import": "./dist/schemas.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && vp pack",
    "check": "vp check",
    "format": "vp check --fix",
    "test": "vp test",
    "test:coverage": "vp test run --coverage",
    "typecheck:portable": "tsc -p tsconfig.portable.json",
    "verify:package": "node scripts/verify-package-install.mjs",
    "prerelease": "vp check && npm run typecheck:portable && vp test run && npm run build && npm run verify:package",
    "prepare": "vp config --no-agent",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@jackemcpherson/rds-js": "^0.3.0",
    "cheerio": "^1.0.0",
    "parse5": "8.0.1",
    "parse5-htmlparser2-tree-adapter": "8.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@clack/prompts": "^1.7.0",
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "5.0.3",
    "citty": "^0.2.2",
    "picocolors": "^1.1.1",
    "typescript": "^7.0.2",
    "vite-plus": "1.1.0"
  },
  "overrides": {
    "fflate": "0.8.3",
    "undici": "^8.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
