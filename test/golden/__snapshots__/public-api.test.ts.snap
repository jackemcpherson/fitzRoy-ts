exports[`public API golden outcomes > keeps the fetchMatches VFL 2019 out of range outcome 1`] = `
{
  "outcome": {
    "err": {
      "fields": {
        "_tag": "OutOfRangeError",
        "competition": "VFL",
        "season": 2019,
        "source": "afl-api",
        "suggestion": undefined,
      },
      "message": "afl-api only covers VFL match from 2021; you asked for 2019",
      "name": "OutOfRangeError",
    },
  },
  "urls": [],
}
`;

exports[`public API golden outcomes > keeps the fetchMatches afl-api 2024 r1 outcome 1`] = `
{
  "outcome": {
    "ok": [
      {
        "attendance": null,
        "awayBehinds": 15,
